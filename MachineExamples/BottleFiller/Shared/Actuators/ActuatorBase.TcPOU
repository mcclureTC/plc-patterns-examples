<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="ActuatorBase" Id="{3e83db22-6fc6-43e6-9531-0792a1f7e6e2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT ActuatorBase IMPLEMENTS I_Actuator, I_Cyclic
VAR
    _Name         : STRING(32);
    _MoveTimeout  : TIME := T#2S;
    _Target       : E_ActuatorTarget;
    _IsInPosition : BOOL;
    _HasFault     : BOOL;
    _FaultText    : STRING(80);
    _MoveTimer    : TON;
    _SettleTimer  : TON;
END_VAR
(*
    ActuatorBase

    The move-and-supervise skeleton shared by every actuator. CyclicLogic() is
    the template: it drives toward the target, checks arrival, supervises the
    move time, goes safe on a fault and lets the actuator settle.

    Derived blocks implement IsWired, DriveOutputs, IsAtPosition and DriveSafe,
    may override SettleTime, and call Configure() from their FB_init.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Actuator" Id="{d2a23e62-a42c-490f-8b2f-01614c085ae0}" />
    <Folder Name="I_Diagnosable" Id="{c331d548-7d01-4669-88e1-7c12b8790ab4}" />
    <Folder Name="I_Resettable" Id="{cd0c58f9-1b07-4718-afd3-ecedbb502416}" />
    <Folder Name="I_Cyclic" Id="{92675993-b21d-482a-91a5-51211caec467}" />
    <Method Name="CyclicLogic" Id="{c859b226-8178-4a98-a057-e16fbb9979a3}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC FINAL CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Not wired: report it, touch nothing
IF NOT IsWired() THEN
    _HasFault := TRUE;
    _FaultText := 'I/O not wired';
    RETURN;
END_IF

// Faulted: only the safe outputs, until Reset()
IF _HasFault THEN
    DriveSafe();
    RETURN;
END_IF

// Drive toward the target, and check whether it has arrived
DriveOutputs(Target := _Target);
_IsInPosition := IsAtPosition(Position := _Target);

// Supervise the move: the same rule for every actuator
_MoveTimer(IN := (_Target <> E_ActuatorTarget.None) AND NOT _IsInPosition, PT := _MoveTimeout);
IF _MoveTimer.Q THEN
    _HasFault := TRUE;
    _FaultText := 'Move did not finish in time';
    DriveSafe();
    RETURN;
END_IF

// Let it settle before reporting the position
_SettleTimer(IN := _IsInPosition, PT := SettleTime);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsWired" Id="{02ba69a4-cbd9-49ae-8815-290902652f4d}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT IsWired : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveOutputs" Id="{5ea62337-b928-49cb-8707-d822012b71d2}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT DriveOutputs
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAtPosition" Id="{ae63f93c-4cd7-41a2-b1de-88f7fb17a129}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT IsAtPosition : BOOL
VAR_INPUT
    Position : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveSafe" Id="{4d68234d-8c5b-4b11-ae0e-0d8405af253d}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT DriveSafe
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="SettleTime" Id="{6ccf9a7a-7bfc-46b1-b7c5-b223c45d6904}">
      <Declaration><![CDATA[PROPERTY PROTECTED SettleTime : TIME]]></Declaration>
      <Get Name="Get" Id="{4c68d280-1a0c-4dda-a029-cad38252ac69}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SettleTime := T#0S;           // most actuators report as soon as the sensor confirms
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{3b6ff6e9-0326-4f04-a7f2-d30900c96c19}">
      <Declaration><![CDATA[METHOD PROTECTED Configure
VAR_INPUT
    Name        : STRING(32);
    MoveTimeout : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
_MoveTimeout := MoveTimeout;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Extend" Id="{f3c1da36-07a5-4401-a839-794ea2315d0f}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[METHOD PUBLIC Extend
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveTo(Target := E_ActuatorTarget.Extended);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retract" Id="{ef1f00c9-5afe-4392-bb3e-098b983fb120}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[METHOD PUBLIC Retract
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveTo(Target := E_ActuatorTarget.Retracted);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveTo" Id="{4aba87ed-07a7-4f68-9950-6d1e8d182c2b}">
      <Declaration><![CDATA[METHOD PRIVATE MoveTo
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _HasFault OR Target = _Target THEN
    RETURN;                        // faulted: Reset() first. Same target: keep the move running.
END_IF
_Target := Target;
_MoveTimer(IN := FALSE);           // every new move gets the full timeout
_SettleTimer(IN := FALSE);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{92fda48d-abab-416d-a213-af20d7aea0bd}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HasFault := FALSE;
_FaultText := '';
_Target := E_ActuatorTarget.None;
_MoveTimer(IN := FALSE);
_SettleTimer(IN := FALSE);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsExtended" Id="{fecc5cef-b3a5-43c7-b8a9-181de633be2f}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsExtended : BOOL]]></Declaration>
      <Get Name="Get" Id="{f2782987-c939-478f-8789-22bf5b7824dd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsExtended := NOT _HasFault AND _Target = E_ActuatorTarget.Extended AND _SettleTimer.Q;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsRetracted" Id="{794c6d14-2e91-4ff6-888b-55ba5a5eb758}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsRetracted : BOOL]]></Declaration>
      <Get Name="Get" Id="{68a50f1c-832a-4e21-adec-fac1ad3feaba}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRetracted := NOT _HasFault AND _Target = E_ActuatorTarget.Retracted AND _SettleTimer.Q;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{e11a851f-76c4-4214-be14-61c4b5475848}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{41083042-326e-497d-99df-a7dd5fc5e68b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := _HasFault;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{4430a890-9722-4300-bc0f-54f50fa9c06a}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{78986b8d-1eff-4ca3-8ce3-c050cf3f5fd5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FaultText := _FaultText;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{09936066-7da8-45f4-8804-2b14ae2867f2}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{5d1a40de-57c1-49cc-a222-51247d48ce6c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
