<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="ActuatorBase" Id="{9d91214a-37e8-4dd8-a6c4-77a51c453dfa}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT ActuatorBase IMPLEMENTS I_Actuator, I_Cyclic
VAR
    _Name         : STRING(32);
    _MoveTimeout  : TIME := T#2S;
    _Target       : E_ActuatorTarget;
    _IsInPosition : BOOL;
    _HasFault     : BOOL;
    _FaultText    : STRING(80);
    _MoveTimer    : TON;
    _SettleTimer  : TON;
END_VAR
(*
    ActuatorBase

    The move-and-supervise skeleton shared by every actuator. CyclicLogic() is
    the template: it drives toward the target, checks arrival, supervises the
    move time, goes safe on a fault and lets the actuator settle.

    Derived blocks implement IsWired, DriveOutputs, IsAtPosition and DriveSafe,
    may override SettleTime, and call Configure() from their FB_init.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Actuator" Id="{38e3b8bd-c8b0-4fa6-8f97-faff425325d2}" />
    <Folder Name="I_Diagnosable" Id="{55f89a45-41c8-4ca3-8306-eddc0d09d3cb}" />
    <Folder Name="I_Resettable" Id="{b9d6e925-70f3-4370-b7b8-0f5c652bb778}" />
    <Folder Name="I_Cyclic" Id="{4401908b-35e2-4d60-99fa-f841d2835c0f}" />
    <Method Name="CyclicLogic" Id="{9c6b3799-1a2c-4eb2-b97e-cc5ce2171fd7}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC FINAL CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Not wired: report it, touch nothing
IF NOT IsWired() THEN
    _HasFault := TRUE;
    _FaultText := 'I/O not wired';
    RETURN;
END_IF

// Faulted: only the safe outputs, until Reset()
IF _HasFault THEN
    DriveSafe();
    RETURN;
END_IF

// Drive toward the target, and check whether it has arrived
DriveOutputs(Target := _Target);
_IsInPosition := IsAtPosition(Position := _Target);

// Supervise the move: the same rule for every actuator
_MoveTimer(IN := (_Target <> E_ActuatorTarget.None) AND NOT _IsInPosition, PT := _MoveTimeout);
IF _MoveTimer.Q THEN
    _HasFault := TRUE;
    _FaultText := 'Move did not finish in time';
    DriveSafe();
    RETURN;
END_IF

// Let it settle before reporting the position
_SettleTimer(IN := _IsInPosition, PT := SettleTime);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsWired" Id="{bd7025df-ddb9-40de-8a0b-10aee7740b27}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT IsWired : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveOutputs" Id="{05a2952e-0300-4761-a60e-7256e61f29a6}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT DriveOutputs
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAtPosition" Id="{7c2c3b56-f529-4504-9f00-f85efac8acf8}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT IsAtPosition : BOOL
VAR_INPUT
    Position : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveSafe" Id="{2d901236-2d64-4643-8c02-5e69813dfdf0}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT DriveSafe
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{81a82bcc-6783-4280-a0df-afec38470988}">
      <Declaration><![CDATA[METHOD PROTECTED Configure
VAR_INPUT
    Name        : STRING(32);
    MoveTimeout : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
_MoveTimeout := MoveTimeout;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Extend" Id="{b0fe1cc4-931a-48f9-babb-cfd4a9d19df1}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[METHOD PUBLIC Extend
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveTo(Target := E_ActuatorTarget.Extended);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retract" Id="{b00301e4-c23a-4efe-bb4e-903ca4cdc4cf}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[METHOD PUBLIC Retract
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveTo(Target := E_ActuatorTarget.Retracted);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveTo" Id="{3685eb9d-30d9-47ea-ac91-fbf9efeec5ff}">
      <Declaration><![CDATA[METHOD PRIVATE MoveTo
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _HasFault OR Target = _Target THEN
    RETURN;                        // faulted: Reset() first. Same target: keep the move running.
END_IF
_Target := Target;
_MoveTimer(IN := FALSE);           // every new move gets the full timeout
_SettleTimer(IN := FALSE);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{389f4ea0-8cf7-44a3-967a-0ddb322f40c7}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HasFault := FALSE;
_FaultText := '';
_Target := E_ActuatorTarget.None;
_MoveTimer(IN := FALSE);
_SettleTimer(IN := FALSE);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="SettleTime" Id="{e9730e0d-fe02-4b49-b374-ec0d800d2181}">
      <Declaration><![CDATA[PROPERTY PROTECTED SettleTime : TIME]]></Declaration>
      <Get Name="Get" Id="{f30b6620-a246-4876-a4b9-11769657437e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SettleTime := T#0S;           // most actuators report as soon as the sensor confirms
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsExtended" Id="{0f580865-9f10-4154-9b07-c30b025ff87c}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsExtended : BOOL]]></Declaration>
      <Get Name="Get" Id="{70e3c045-4a64-4a0b-94f3-37363e38f1c5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsExtended := NOT _HasFault AND _Target = E_ActuatorTarget.Extended AND _SettleTimer.Q;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsRetracted" Id="{e4265b08-0248-4f27-a454-25774acf5097}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsRetracted : BOOL]]></Declaration>
      <Get Name="Get" Id="{66305fa0-1181-4c32-8528-d40104c4dc3e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRetracted := NOT _HasFault AND _Target = E_ActuatorTarget.Retracted AND _SettleTimer.Q;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{ea70bcf7-3726-4f75-bc86-db4aadd8c740}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{f4c6f1db-d6e0-4035-b770-d71a54bf704d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := _HasFault;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{a770c4de-058a-46be-85b2-1bddf0645120}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{6ff391ab-3892-4615-ad97-4446abf1f1de}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FaultText := _FaultText;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{6fb225ce-5d6f-4fc7-9ccf-9f2c449995e2}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{1dd11277-b727-47b8-a5c4-fba48cc804b5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
