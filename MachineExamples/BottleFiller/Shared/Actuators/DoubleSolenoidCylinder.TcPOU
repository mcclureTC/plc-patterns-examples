<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="DoubleSolenoidCylinder" Id="{415738d0-901f-423e-af36-d726b102f31d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK DoubleSolenoidCylinder EXTENDS ActuatorBase
VAR
    _ExtendCoil      : REFERENCE TO BOOL;
    _RetractCoil     : REFERENCE TO BOOL;
    _ExtendedSensor  : REFERENCE TO BOOL;
    _RetractedSensor : REFERENCE TO BOOL;
END_VAR
(*
    DoubleSolenoidCylinder

    One coil per direction. With both coils off, the valve holds the cylinder
    where it is. An end sensor at each end.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{b14dfbc1-cc15-4246-870c-e1c7060cf7cc}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains    : BOOL;
    bInCopyCode     : BOOL;
    Name            : STRING(32);
    MoveTimeout     : TIME;
    ExtendCoil      : REFERENCE TO BOOL;
    RetractCoil     : REFERENCE TO BOOL;
    ExtendedSensor  : REFERENCE TO BOOL;
    RetractedSensor : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExtendCoil REF= ExtendCoil;
_RetractCoil REF= RetractCoil;
_ExtendedSensor REF= ExtendedSensor;
_RetractedSensor REF= RetractedSensor;
Configure(Name := Name, MoveTimeout := MoveTimeout);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsWired" Id="{0656934a-3dfe-4388-af8e-f6604efdc80f}">
      <Declaration><![CDATA[METHOD PROTECTED IsWired : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsWired := __ISVALIDREF(_ExtendCoil) AND __ISVALIDREF(_RetractCoil)
       AND __ISVALIDREF(_ExtendedSensor) AND __ISVALIDREF(_RetractedSensor);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveOutputs" Id="{a88c2a76-e795-486d-8a66-2a4cf1b70821}">
      <Declaration><![CDATA[METHOD PROTECTED DriveOutputs
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExtendCoil := Target = E_ActuatorTarget.Extended;
_RetractCoil := Target = E_ActuatorTarget.Retracted;  // None: both off, so it holds
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAtPosition" Id="{518a75e4-c771-4715-8a6e-a3472b8ffcd3}">
      <Declaration><![CDATA[METHOD PROTECTED IsAtPosition : BOOL
VAR_INPUT
    Position : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Position OF
    E_ActuatorTarget.Extended:
        IsAtPosition := _ExtendedSensor AND NOT _RetractedSensor;
    E_ActuatorTarget.Retracted:
        IsAtPosition := _RetractedSensor AND NOT _ExtendedSensor;
ELSE
    IsAtPosition := FALSE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveSafe" Id="{2849599d-40ff-41ff-8799-1d5c4fa3388b}">
      <Declaration><![CDATA[METHOD PROTECTED DriveSafe
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExtendCoil := FALSE;                               // both off: the cylinder stays where it is
_RetractCoil := FALSE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
