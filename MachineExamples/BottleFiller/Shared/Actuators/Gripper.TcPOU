<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="Gripper" Id="{20dc8eb9-9225-4de5-a77d-3bf4e45ca98b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Gripper EXTENDS SingleSolenoidCylinder
(*
    Gripper

    A single-solenoid gripper: Extend closes, Retract opens. After the closed
    sensor confirms, the jaws need a moment to build full grip pressure.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="SettleTime" Id="{c0158ccc-6ed3-45d1-b206-b70b5ceb6cd6}">
      <Declaration><![CDATA[PROPERTY PROTECTED SettleTime : TIME]]></Declaration>
      <Get Name="Get" Id="{70fd461b-1a68-43a8-b78c-3401cff58c6c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SettleTime := T#150MS;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
