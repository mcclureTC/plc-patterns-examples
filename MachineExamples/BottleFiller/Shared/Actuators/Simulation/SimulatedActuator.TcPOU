<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="SimulatedActuator" Id="{ac7c9dc8-0fef-4577-a3cc-72bd5e49513a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SimulatedActuator EXTENDS ActuatorBase
VAR
    _TravelTime   : TIME;
    _DrivenTarget : E_ActuatorTarget;
    _Travel       : TON;
    _IsStuck      : BOOL;
END_VAR
(*
    SimulatedActuator

    Stands in for a cylinder or gripper with end sensors. Reaches the
    commanded end TravelTime after the move starts. The supervision is
    ActuatorBase's, unchanged, so a move that never arrives faults exactly
    as a real one would. SetStuck() stops it moving. Has no I/O.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{5fa20193-0913-4b76-9672-a3f4cb9718cc}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
    MoveTimeout  : TIME;
    TravelTime   : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TravelTime := TravelTime;
Configure(Name := Name, MoveTimeout := MoveTimeout);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetStuck" Id="{95b7ad40-d702-4b8a-b1cc-5248ef6ca77d}">
      <Declaration><![CDATA[METHOD PUBLIC SetStuck
VAR_INPUT
    IsStuck : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsStuck := IsStuck;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsWired" Id="{71d07e8f-3473-488d-87b8-4b178dfb99e3}">
      <Declaration><![CDATA[METHOD PROTECTED IsWired : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsWired := TRUE;                                    // nothing to wire
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveOutputs" Id="{526cc409-5a8d-4f42-b10c-1b9a4b9ff44f}">
      <Declaration><![CDATA[METHOD PROTECTED DriveOutputs
VAR_INPUT
    Target : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Target <> _DrivenTarget THEN
    _DrivenTarget := Target;
    _Travel(IN := FALSE);                           // a new move starts from the beginning
END_IF
_Travel(IN := Target <> E_ActuatorTarget.None AND NOT _IsStuck, PT := _TravelTime);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAtPosition" Id="{502484e1-d81a-4713-8a51-3f810359a5ee}">
      <Declaration><![CDATA[METHOD PROTECTED IsAtPosition : BOOL
VAR_INPUT
    Position : E_ActuatorTarget;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsAtPosition := Position <> E_ActuatorTarget.None AND Position = _DrivenTarget AND _Travel.Q;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DriveSafe" Id="{ffbc2ddf-9b3f-4e61-96aa-cf632c6edc87}">
      <Declaration><![CDATA[METHOD PROTECTED DriveSafe
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Travel(IN := FALSE);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
