<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FillValveRouter" Id="{43b2b1bd-8c43-46e1-8f96-5f20d251f799}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FillValveRouter IMPLEMENTS I_FillValve, I_Cyclic
VAR
    _Name   : STRING(32);
    _Source : E_DeviceSource;
    _Chosen : I_FillValve;
END_VAR
(*
    FillValveRouter

    One I_FillValve in front of up to four candidates. The site setting,
    given once in FB_init, chooses which candidate answers and which one
    is run. A source with no candidate (0) reports a fault and is never
    open.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_FillValve" Id="{78a38160-681e-41d0-ac09-f902fd60cfb1}" />
    <Folder Name="I_Diagnosable" Id="{5ba4f0b3-65eb-49e7-b7f9-e198beffb35b}" />
    <Folder Name="I_Cyclic" Id="{a40dad8e-c43b-4a19-9a43-9595b3a05ecc}" />
    <Method Name="FB_init" Id="{3898d12b-dd24-4801-ba44-53591b5dda70}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains    : BOOL;
    bInCopyCode     : BOOL;
    Name            : STRING(32);
    Source          : E_DeviceSource;
    FinalHardware   : I_FillValve;
    SimilarHardware : I_FillValve;
    Simulation      : I_FillValve;
    Test            : I_FillValve;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
_Source := Source;
CASE Source OF
    E_DeviceSource.FinalHardware:   _Chosen := FinalHardware;
    E_DeviceSource.SimilarHardware: _Chosen := SimilarHardware;
    E_DeviceSource.Simulation:      _Chosen := Simulation;
    E_DeviceSource.Test:            _Chosen := Test;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{db5e4f5d-90fd-494f-bbd1-38b4ec530226}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
VAR
    Cyclic : I_Cyclic;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Chosen <> 0 AND_THEN __QUERYINTERFACE(_Chosen, Cyclic) THEN
    Cyclic.CyclicLogic();              // only the chosen candidate runs
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{3bd6bfd4-1210-47d3-aade-8d140afd5d8d}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[METHOD PUBLIC Open
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Chosen <> 0 THEN
    _Chosen.Open();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close" Id="{fbd055d6-8b76-4759-86fa-50c9eb554f57}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[METHOD PUBLIC Close
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Chosen <> 0 THEN
    _Chosen.Close();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsOpen" Id="{3147a70b-f2dd-4c39-ad64-b12222a632e5}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsOpen : BOOL]]></Declaration>
      <Get Name="Get" Id="{06b6970a-fc73-484d-af25-f8bc34371284}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsOpen := _Chosen <> 0 AND_THEN _Chosen.IsOpen;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsClosed" Id="{47674bd4-68c3-4600-8e32-a84d8942dd1a}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsClosed : BOOL]]></Declaration>
      <Get Name="Get" Id="{94d63ad2-9caa-43df-b9fc-c6dbecd98dc0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsClosed := _Chosen <> 0 AND_THEN _Chosen.IsClosed;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{7853ee77-e746-4f5d-990b-6700e4676038}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{b477168a-597b-4172-b002-9129e3e094fe}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{7128146a-2abd-42b5-8b18-7c2f9560e5ca}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{049ddcdc-bae0-4c32-832d-aef2d608b0a0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := _Chosen = 0 OR_ELSE _Chosen.HasFault;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{892597db-190d-4fd9-aa85-3cb9c0a324a6}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{d33a5729-3129-46a7-884f-343ba138382a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Chosen = 0 THEN
    FaultText := 'No device for this source';
ELSE
    FaultText := _Chosen.FaultText;
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Source" Id="{7fc3c4be-5eb2-4b40-b216-c59fadaf26b1}">
      <Declaration><![CDATA[PROPERTY PUBLIC Source : E_DeviceSource]]></Declaration>
      <Get Name="Get" Id="{7399d212-b68a-4cc5-a2c8-ed526745dfa1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Source := _Source;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
