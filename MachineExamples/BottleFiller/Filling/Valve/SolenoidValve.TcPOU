<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="SolenoidValve" Id="{fd880ab6-c8ce-42c9-a59c-218cf7a5749a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SolenoidValve IMPLEMENTS I_FillValve, I_Resettable, I_Cyclic
VAR
    _Name          : STRING(32) := 'Solenoid valve';
    _Output        : REFERENCE TO BOOL;
    _OpenFeedback  : REFERENCE TO BOOL;
    _FaultDelay    : TIME;
    _Command       : BOOL;
    _MismatchTimer : TON;
    _IsConfigured  : BOOL;
END_VAR
(*
    SolenoidValve

    Drives one solenoid valve and checks its open-feedback switch. A fault
    is reported while the feedback has disagreed with the command for
    longer than FaultDelay. Name can be set while wiring.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_FillValve" Id="{4e35492a-8faa-4cee-a833-d6fb69e86dea}" />
    <Folder Name="I_Diagnosable" Id="{e5051048-e54b-4183-9fb8-a59ac8df216c}" />
    <Folder Name="I_Resettable" Id="{806912db-00f7-4398-b128-85af1f8d730d}" />
    <Folder Name="I_Cyclic" Id="{985bb404-9ec5-4ed1-85a8-808c5d994cbf}" />
    <Method Name="FB_init" Id="{bb7cce40-1440-4d60-afe9-83ac454f6afd}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Output       : REFERENCE TO BOOL;
    OpenFeedback : REFERENCE TO BOOL;
    FaultDelay   : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Output REF= Output;
_OpenFeedback REF= OpenFeedback;
_FaultDelay := FaultDelay;
_IsConfigured := __ISVALIDREF(Output) AND __ISVALIDREF(OpenFeedback);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{7a1466c0-67af-43ea-9e6e-455a9a3b0393}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[METHOD PUBLIC Open
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Command := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close" Id="{f35b833f-499e-45c4-a4e1-2cd49cd1bc4d}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[METHOD PUBLIC Close
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Command := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{fd591b0e-e446-4162-bc73-af7e43179407}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsConfigured THEN
    RETURN;
END_IF
_Output := _Command;
_MismatchTimer(IN := _Command XOR _OpenFeedback, PT := _FaultDelay);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{039ab248-d261-4f62-958b-75dd20f668e1}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MismatchTimer(IN := FALSE);                        // supervise again from now
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsOpen" Id="{8371f707-a765-44e8-807f-e43a7d07b20d}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsOpen : BOOL]]></Declaration>
      <Get Name="Get" Id="{7e5f50db-31f7-4af5-8459-1db6e26d63cf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsOpen := _IsConfigured AND_THEN (_Command AND _OpenFeedback);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsClosed" Id="{6754a114-989f-4e06-81b8-98efc798da79}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsClosed : BOOL]]></Declaration>
      <Get Name="Get" Id="{100f29e0-7fa5-4fbe-90e5-1ab2ce6d75a9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsClosed := _IsConfigured AND_THEN NOT (_Command OR _OpenFeedback);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{21d71350-aefb-4f12-b4f1-cd302f40f7ac}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{9560971e-e8cf-4fb4-a1c5-3069d47eb8b4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := NOT _IsConfigured OR _MismatchTimer.Q;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{4b72d7cc-454d-4720-8732-d8d84d6fb803}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{0b364971-f0fe-404e-b312-a065978fca52}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _IsConfigured THEN
    FaultText := 'I/O not wired';
ELSIF _MismatchTimer.Q THEN
    FaultText := 'No feedback';
ELSE
    FaultText := '';
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{659692b0-5420-4956-93aa-a22d2e83aaeb}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{740a803d-9082-43b5-9cab-6e5c78414479}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{865bb9e0-5889-4d66-bb09-92e859702587}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Name := Name;
]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
