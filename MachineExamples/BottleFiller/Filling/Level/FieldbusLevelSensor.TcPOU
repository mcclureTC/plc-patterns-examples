<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FieldbusLevelSensor" Id="{764ff014-b3f0-4340-ab59-d76edc8ecf7e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FieldbusLevelSensor IMPLEMENTS I_LevelSensor
VAR
    _FieldbusLevel     : REFERENCE TO DINT;
    _IsCommunicationOk : REFERENCE TO BOOL;
    _TankHeight        : REAL;
    _IsConfigured      : BOOL;
END_VAR
(* FieldbusLevelSensor: a level sensor that reports its reading over a fieldbus, in 0.1 mm. *)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_LevelSensor" Id="{91296713-b94f-4a18-b86e-117fabb4d6a1}" />
    <Method Name="FB_init" Id="{f91ac276-3aaa-4534-b1a1-79fa023b6e58}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains      : BOOL;
    bInCopyCode       : BOOL;
    FieldbusLevel     : REFERENCE TO DINT;   // process data from the sensor, 0.1 mm
    IsCommunicationOk : REFERENCE TO BOOL;
    TankHeight        : REAL;                // mm
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FieldbusLevel REF= FieldbusLevel;
_IsCommunicationOk REF= IsCommunicationOk;
_TankHeight := TankHeight;
_IsConfigured := __ISVALIDREF(FieldbusLevel) AND __ISVALIDREF(IsCommunicationOk) AND TankHeight > 0.0;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsValid" Id="{9b07ebfb-b2e0-4d3a-8a85-a623d7d7cd5a}" FolderPath="I_LevelSensor\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{1532e17b-3134-4726-8a2b-bec267dbe063}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsValid := _IsConfigured AND_THEN _IsCommunicationOk;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Level" Id="{e3c11d47-521c-47e6-b6f4-d72c5f01a15a}" FolderPath="I_LevelSensor\">
      <Declaration><![CDATA[PROPERTY PUBLIC Level : REAL]]></Declaration>
      <Get Name="Get" Id="{707441fb-8ac7-423f-afa1-78e2deec118e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF IsValid THEN
    Level := LIMIT(0.0, DINT_TO_REAL(_FieldbusLevel) / 10.0 / _TankHeight * 100.0, 100.0);
ELSE
    Level := 0.0;
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
