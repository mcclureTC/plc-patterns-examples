<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="LevelSensorRouter" Id="{3c3c3c52-dd9f-4c3a-a13d-d441d914f8c4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK LevelSensorRouter IMPLEMENTS I_LevelSensor, I_Cyclic
VAR
    _Name   : STRING(32);
    _Source : E_DeviceSource;
    _Chosen : I_LevelSensor;
END_VAR
(*
    LevelSensorRouter

    One I_LevelSensor in front of up to four candidates, chosen once by
    the site setting. A source with no candidate (0) is never valid.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_LevelSensor" Id="{d52faa10-98ca-4350-ad88-edeed42a0bf8}" />
    <Folder Name="I_Cyclic" Id="{e026fc06-f679-4af0-92b4-a5d36ca8f93c}" />
    <Method Name="FB_init" Id="{53b0f04c-8a85-47d9-be68-d7769d239514}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains    : BOOL;
    bInCopyCode     : BOOL;
    Name            : STRING(32);
    Source          : E_DeviceSource;
    FinalHardware   : I_LevelSensor;
    SimilarHardware : I_LevelSensor;
    Simulation      : I_LevelSensor;
    Test            : I_LevelSensor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
_Source := Source;
CASE Source OF
    E_DeviceSource.FinalHardware:   _Chosen := FinalHardware;
    E_DeviceSource.SimilarHardware: _Chosen := SimilarHardware;
    E_DeviceSource.Simulation:      _Chosen := Simulation;
    E_DeviceSource.Test:            _Chosen := Test;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{de2026e1-92a5-40c9-a383-d098c68c90dd}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
VAR
    Cyclic : I_Cyclic;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Chosen <> 0 AND_THEN __QUERYINTERFACE(_Chosen, Cyclic) THEN
    Cyclic.CyclicLogic();              // only the chosen candidate runs
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Level" Id="{39f3ffe4-1730-4bea-8db9-8a8e1aaac06b}" FolderPath="I_LevelSensor\">
      <Declaration><![CDATA[PROPERTY PUBLIC Level : REAL]]></Declaration>
      <Get Name="Get" Id="{f236e14e-852a-45e9-a09c-10f8f2108865}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Chosen <> 0 THEN
    Level := _Chosen.Level;
ELSE
    Level := 0.0;
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsValid" Id="{c68b02a9-3a59-4c4f-94b7-015c400a9172}" FolderPath="I_LevelSensor\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{f16af180-e3da-429c-b732-194ab711c6ac}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsValid := _Chosen <> 0 AND_THEN _Chosen.IsValid;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{3df9cc72-9f24-4467-abaf-22aea8ed02ff}">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{518a751e-fbbb-4043-b22b-bc9864399f76}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Source" Id="{14a49bac-d635-4875-98ad-21dcd15890c8}">
      <Declaration><![CDATA[PROPERTY PUBLIC Source : E_DeviceSource]]></Declaration>
      <Get Name="Get" Id="{57120ee6-27a4-402d-a591-c8f43767061a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Source := _Source;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
