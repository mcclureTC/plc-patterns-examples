<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FillSequence" Id="{92b33afb-d567-4e27-8f7b-75100cf47966}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FillSequence
VAR
    _LevelSensor      : I_LevelSensor;
    _FillValve        : I_FillValve;
    _TargetLevel      : REAL := 80.0;
    _CurrentStep      : E_FillStep := E_FillStep.Idle;
    _IsStartRequested : BOOL;
    _IsResetRequested : BOOL;
    _IsConfigured     : BOOL;
END_VAR
(*
    FillSequence

    Opens the fill valve, waits for the target level, closes the valve.
    Talks only to I_LevelSensor and I_FillValve, injected through FB_init.

    Call CyclicLogic() once per cycle. Start() and Reset() are requests,
    seen during the next CyclicLogic() call.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Start" Id="{a0ca7d85-b9a0-4ae2-a81c-d2cb2be96728}">
      <Declaration><![CDATA[METHOD PUBLIC Start
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsStartRequested := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{54039c1d-5cee-43a8-957d-d8559e480502}">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsResetRequested := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{9bf792a6-4ba8-42c9-8b15-2fde260bb80e}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsConfigured THEN
    _CurrentStep := E_FillStep.Error;   // not wired: fail safe, never call through 0
    RETURN;
END_IF

CASE _CurrentStep OF
    E_FillStep.Idle, E_FillStep.Done:
        IF _IsStartRequested THEN
            _CurrentStep := E_FillStep.Opening;
        END_IF

    E_FillStep.Opening:
        _FillValve.Open();
        IF _FillValve.IsOpen THEN
            _CurrentStep := E_FillStep.Filling;
        ELSIF _FillValve.HasFault THEN
            _CurrentStep := E_FillStep.Error;
        END_IF

    E_FillStep.Filling:
        IF NOT _LevelSensor.IsValid OR _FillValve.HasFault THEN
            _CurrentStep := E_FillStep.Error;
        ELSIF _LevelSensor.Level >= _TargetLevel THEN
            _CurrentStep := E_FillStep.Closing;
        END_IF

    E_FillStep.Closing:
        _FillValve.Close();
        IF _FillValve.IsClosed THEN
            _CurrentStep := E_FillStep.Done;
        ELSIF _FillValve.HasFault THEN
            _CurrentStep := E_FillStep.Error;
        END_IF

    E_FillStep.Error:
        _FillValve.Close();             // the one promise every valve keeps
        IF _IsResetRequested AND _FillValve.IsClosed THEN
            _CurrentStep := E_FillStep.Idle;
        END_IF
END_CASE

_IsStartRequested := FALSE;
_IsResetRequested := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="TargetLevel" Id="{435c724b-19ed-4647-b1f8-b0e854d41da4}">
      <Declaration><![CDATA[PROPERTY PUBLIC TargetLevel : REAL]]></Declaration>
      <Get Name="Get" Id="{668b7bf1-850b-4c18-ab82-5c6cffb12ce4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TargetLevel := _TargetLevel;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{21956a4a-cba6-4346-bfdd-d6650a4e6ea9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_TargetLevel := LIMIT(0.0, TargetLevel, 100.0);
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="CurrentStep" Id="{3082776b-b121-44ab-84ed-94f89336af51}">
      <Declaration><![CDATA[PROPERTY PUBLIC CurrentStep : E_FillStep]]></Declaration>
      <Get Name="Get" Id="{e686a673-a848-4a38-a7e3-d0f5a725f742}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentStep := _CurrentStep;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsBusy" Id="{2d5bf083-d509-47d1-b765-e91387dacf87}">
      <Declaration><![CDATA[PROPERTY PUBLIC IsBusy : BOOL]]></Declaration>
      <Get Name="Get" Id="{1f76769b-fbee-4757-86b4-2f62da0b9781}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsBusy := _CurrentStep = E_FillStep.Opening
            OR _CurrentStep = E_FillStep.Filling
            OR _CurrentStep = E_FillStep.Closing;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsDone" Id="{dedc9cc8-6b79-48ee-bdbf-4e43fb2ff01e}">
      <Declaration><![CDATA[PROPERTY PUBLIC IsDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{55bd4405-6b50-48f8-846c-f20f6a11174d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsDone := _CurrentStep = E_FillStep.Done;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasError" Id="{5f621a0e-8900-43f8-a157-b08e3cf60c84}">
      <Declaration><![CDATA[PROPERTY PUBLIC HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{b01e3d23-e1ca-4c1c-a1e0-224071eda3b4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := _CurrentStep = E_FillStep.Error;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{f6413a0a-711a-4faa-9f3a-ba0139e2d3e8}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    LevelSensor  : I_LevelSensor;
    FillValve    : I_FillValve;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LevelSensor := LevelSensor;
_FillValve := FillValve;
_IsConfigured := LevelSensor <> 0 AND FillValve <> 0;   // stored: FB_init's return value is ignored
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
