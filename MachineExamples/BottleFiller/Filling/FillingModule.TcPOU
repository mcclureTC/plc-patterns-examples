<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FillingModule" Id="{569bb606-a72e-450c-a7cc-2ddcce2d9e16}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FillingModule EXTENDS ModuleGroup IMPLEMENTS I_EquipmentModule
VAR
    _Fill             : REFERENCE TO FillSequence;
    _Dose             : I_Command;
    _IsCycleRequested : BOOL;
    _IsFilling        : BOOL;
    _IsDosing         : BOOL;
    _HasDoseFault     : BOOL;
    _DoseFault        : STRING;
    _IsConfigured     : BOOL;
END_VAR
(*
    FillingModule

    The filling station. One cycle measures one dose: the fill sequence
    fills the dosing tank to its target level, then the dose command
    drains it into the bottle below. Runs both before its valves. It has
    a fault while a valve has one, the fill sequence has stopped with an
    error, or the last dose ended in Error; Reset() clears all three.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_EquipmentModule" Id="{e7d69ba2-092b-45df-b079-ee50e76aba72}" />
    <Folder Name="I_Diagnosable" Id="{c0e836ea-02fd-4071-b78b-724402a9cde3}" />
    <Folder Name="I_Resettable" Id="{4f9c1b3d-ded0-4f18-ac38-21948a2bce96}" />
    <Method Name="FB_init" Id="{1252bf98-d5f3-4fa3-bbeb-d5acc8a613f4}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);                  // for EquipmentGroup
    Fill         : REFERENCE TO FillSequence;
    Dose         : I_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Fill REF= Fill;
_Dose := Dose;
_IsConfigured := __ISVALIDREF(Fill) AND Dose <> 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartCycle" Id="{1f26a62c-adbb-4719-8ad0-37864c272eb2}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[METHOD PUBLIC StartCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsCycleRequested := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeChildren" Id="{d956a250-4eff-4d23-8cb7-d08981cf28e5}">
      <Declaration><![CDATA[METHOD PROTECTED BeforeChildren
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsConfigured THEN
    RETURN;
END_IF

// A new cycle starts with the fill, once the station is free
IF _IsCycleRequested AND NOT _IsFilling AND NOT _IsDosing
   AND (_Fill.CurrentStep = E_FillStep.Idle OR _Fill.CurrentStep = E_FillStep.Done) THEN
    _Fill.Start();
    _IsFilling := TRUE;
    _IsCycleRequested := FALSE;
END_IF
_Fill.CyclicLogic();

// The tank is at its level: dose it into the bottle
IF _IsFilling AND _Fill.IsDone THEN
    _IsFilling := FALSE;
    _Dose.Start();
    _IsDosing := TRUE;
END_IF
IF _IsDosing THEN
    _Dose.CyclicLogic();
    IF _Dose.State = E_OperationState.Error THEN
        _HasDoseFault := TRUE;
        _DoseFault := _Dose.FaultText;
        _IsDosing := FALSE;
    ELSIF _Dose.State = E_OperationState.Done THEN
        _IsDosing := FALSE;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{2deb6410-590e-4338-b57e-0e526355480d}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Reset();                                 // the valves
IF NOT _IsConfigured THEN
    RETURN;
END_IF
_Fill.Reset();
IF _IsDosing THEN
    _Dose.Abort();                              // closes the drain valve
END_IF
_IsCycleRequested := FALSE;
_IsFilling := FALSE;
_IsDosing := FALSE;
_HasDoseFault := FALSE;
_DoseFault := '';
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsCycleDone" Id="{3859f42a-225e-4fcb-8630-ede6fda7372c}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsCycleDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{346a61ed-0143-4239-8f17-3222dfc6c96f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsCycleDone := _IsConfigured AND_THEN (NOT _IsCycleRequested AND NOT _IsFilling AND NOT _IsDosing
                                             AND _Dose.State = E_OperationState.Done);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{73153566-d6a1-4657-b43e-a5dddeac9217}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{779495ae-9317-4017-ac13-db13937ac880}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _IsConfigured THEN
    HasFault := TRUE;
ELSE
    HasFault := SUPER^.HasFault OR _Fill.HasError OR _HasDoseFault;
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{aee96d7d-650c-43f8-879e-a537533e5a51}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{585c260f-651e-462b-8013-f47bb3f034d6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _IsConfigured THEN
    FaultText := 'Filling station not wired';
ELSIF SUPER^.HasFault THEN
    FaultText := SUPER^.FaultText;              // the valve, by name
ELSIF _Fill.HasError THEN
    FaultText := 'Fill stopped; reset to continue';
ELSIF _HasDoseFault THEN
    FaultText := CONCAT('Dose: ', _DoseFault);
ELSE
    FaultText := '';
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
