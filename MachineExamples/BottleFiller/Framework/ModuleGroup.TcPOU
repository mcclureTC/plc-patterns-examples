<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="ModuleGroup" Id="{fa52b04a-1597-41b2-964c-82819b8d2af8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ModuleGroup EXTENDS EquipmentGroup IMPLEMENTS I_Cyclic
VAR
    _Cyclics : ARRAY[0..MaxChildren - 1] OF I_Cyclic;
END_VAR
(*
    ModuleGroup

    An EquipmentGroup that also runs its children: one CyclicLogic() call
    runs every child that implements I_Cyclic, in the order they were
    added, between this module's own BeforeChildren() and AfterChildren().
    A station with logic of its own extends it and overrides the hooks.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Cyclic" Id="{f27b1504-c8b1-47e4-95fd-e69c6fa98599}" />
    <Method Name="AddChild" Id="{b084ecc5-2c16-43c7-8521-4bd175a74bc5}">
      <Declaration><![CDATA[METHOD PUBLIC AddChild : BOOL
VAR_INPUT
    Child : I_Diagnosable;
END_VAR
VAR
    Cyclic : I_Cyclic;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT SUPER^.AddChild(Child := Child) THEN
    AddChild := FALSE;
    RETURN;
END_IF
IF __QUERYINTERFACE(Child, Cyclic) THEN
    _Cyclics[_Count - 1] := Cyclic;   // the slot SUPER^.AddChild() just filled
END_IF
AddChild := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{8835ee07-d9e4-4a29-a321-5187496f430d}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC FINAL CyclicLogic
VAR
    i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BeforeChildren();
FOR i := 0 TO _Count - 1 DO
    IF _Cyclics[i] <> 0 THEN
        _Cyclics[i].CyclicLogic();
    END_IF
END_FOR
AfterChildren();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeChildren" Id="{bc68d170-c847-43f8-9471-5a2b7826c648}">
      <Declaration><![CDATA[METHOD PROTECTED BeforeChildren      // decide what the children should do this scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterChildren" Id="{e391214e-3bed-4ff4-89c6-2cd45ab234cb}">
      <Declaration><![CDATA[METHOD PROTECTED AfterChildren       // read what they reported this scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
