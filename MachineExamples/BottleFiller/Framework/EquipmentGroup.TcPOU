<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="EquipmentGroup" Id="{2b58e42f-f08f-43b2-a9cf-c6bdc073792c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK EquipmentGroup IMPLEMENTS I_Diagnosable, I_Resettable
VAR CONSTANT
    MaxChildren : DINT := 16;
END_VAR
VAR
    _Name        : STRING(32);
    _Children    : ARRAY[0..MaxChildren - 1] OF I_Diagnosable;
    _Resettables : ARRAY[0..MaxChildren - 1] OF I_Resettable;
    _Count       : DINT;
END_VAR
(*
    EquipmentGroup

    A named group of devices or other groups, behind the same interfaces
    as one device. It has a fault while any child has one, and reports
    the first faulted child's text, prefixed with that child's name.
    Reset() resets every child that implements I_Resettable.
    AddChild() is called while wiring, before the group is first asked.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Diagnosable" Id="{3403eac3-7424-410f-bea2-ae39bbd3a87b}" />
    <Folder Name="I_Resettable" Id="{e743756a-9fd1-4bea-bb27-44e9c2526555}" />
    <Method Name="FB_init" Id="{448ea1fd-7c35-4e7e-8f1e-180e87601271}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddChild" Id="{c23be909-bbc2-411f-8ef6-11c58a7de8d3}">
      <Declaration><![CDATA[METHOD PUBLIC AddChild : BOOL
VAR_INPUT
    Child : I_Diagnosable;
END_VAR
VAR
    Me         : I_Diagnosable;
    Resettable : I_Resettable;
    i          : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Me := THIS^;
IF Child = 0 OR Child = Me OR _Count >= MaxChildren THEN
    AddChild := FALSE;
    RETURN;
END_IF
FOR i := 0 TO _Count - 1 DO           // the same child only once
    IF _Children[i] = Child THEN
        AddChild := FALSE;
        RETURN;
    END_IF
END_FOR
_Children[_Count] := Child;
IF __QUERYINTERFACE(Child, Resettable) THEN
    _Resettables[_Count] := Resettable;
END_IF
_Count := _Count + 1;
AddChild := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{e0c628a9-3646-40d5-b098-c27a8e41ff79}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
VAR
    i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _Count - 1 DO
    IF _Resettables[i] <> 0 THEN
        _Resettables[i].Reset();
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FirstFaultIndex" Id="{87b59f4c-92d0-4f8b-ba12-875f7c31718d}">
      <Declaration><![CDATA[METHOD PRIVATE FirstFaultIndex : DINT
VAR
    i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _Count - 1 DO
    IF _Children[i].HasFault THEN
        FirstFaultIndex := i;
        RETURN;
    END_IF
END_FOR
FirstFaultIndex := _Count;            // no child has a fault
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DescribeFault" Id="{f37a365d-28d9-48df-9177-0189a69aa6f9}">
      <Declaration><![CDATA[METHOD PRIVATE DescribeFault : STRING
VAR_INPUT
    Index : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[DescribeFault := '';
IF Index < _Count THEN
    DescribeFault := CONCAT(CONCAT(_Children[Index].Name, ': '), _Children[Index].FaultText);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{57baa320-57ab-4256-b6eb-e4eac9eab599}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{926d51e7-fc20-4a8b-9bd2-87458e05794a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{f592a4d7-3821-44b9-8bf3-9f5d2592f242}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{2912a64e-f2f8-4648-94b9-5eac5cb5d462}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := FirstFaultIndex() < _Count;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{0bc678e7-1940-474f-9adf-a2aff4a32d3a}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{ab8e4837-e15a-4727-882d-b07712806fdf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FaultText := DescribeFault(Index := FirstFaultIndex());
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ChildCount" Id="{8d8cdfd2-140f-47d4-ae65-d9e1d6d925f0}">
      <Declaration><![CDATA[PROPERTY PUBLIC ChildCount : DINT]]></Declaration>
      <Get Name="Get" Id="{b9e16875-a1ef-4644-8afa-1f2bab6fb77f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildCount := _Count;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
