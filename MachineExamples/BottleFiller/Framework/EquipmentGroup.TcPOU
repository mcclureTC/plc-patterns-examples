<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="EquipmentGroup" Id="{df4d33af-2551-433b-8607-e9e14ad03a2e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK EquipmentGroup IMPLEMENTS I_Diagnosable, I_Resettable
VAR CONSTANT
    MaxChildren : DINT := 16;
END_VAR
VAR
    _Name        : STRING(32);
    _Children    : ARRAY[0..MaxChildren - 1] OF I_Diagnosable;
    _Resettables : ARRAY[0..MaxChildren - 1] OF I_Resettable;
    _Count       : DINT;
END_VAR
(*
    EquipmentGroup

    A named group of devices or other groups, behind the same interfaces
    as one device. It has a fault while any child has one, and reports
    the first faulted child's text, prefixed with that child's name.
    Reset() resets every child that implements I_Resettable.
    AddChild() is called while wiring, before the group is first asked.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Diagnosable" Id="{dbc7c784-3082-4e7a-a527-52be38b83f31}" />
    <Folder Name="I_Resettable" Id="{5b93e3e1-9ead-48ca-b8de-caa4b189f039}" />
    <Method Name="FB_init" Id="{37459d52-9f7c-4e5c-80cd-c895d42c7ab4}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddChild" Id="{2abd6778-5a9d-480f-a4d1-978c85c747ec}">
      <Declaration><![CDATA[METHOD PUBLIC AddChild : BOOL
VAR_INPUT
    Child : I_Diagnosable;
END_VAR
VAR
    Me         : I_Diagnosable;
    Resettable : I_Resettable;
    i          : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Me := THIS^;
IF Child = 0 OR Child = Me OR _Count >= MaxChildren THEN
    AddChild := FALSE;
    RETURN;
END_IF
FOR i := 0 TO _Count - 1 DO           // the same child only once
    IF _Children[i] = Child THEN
        AddChild := FALSE;
        RETURN;
    END_IF
END_FOR
_Children[_Count] := Child;
IF __QUERYINTERFACE(Child, Resettable) THEN
    _Resettables[_Count] := Resettable;
END_IF
_Count := _Count + 1;
AddChild := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{d83eb1a0-a4bb-4045-a892-564ca39b5da8}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
VAR
    i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _Count - 1 DO
    IF _Resettables[i] <> 0 THEN
        _Resettables[i].Reset();
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FirstFaultIndex" Id="{f829a151-4e73-404f-9013-ffc49c6a383e}">
      <Declaration><![CDATA[METHOD PRIVATE FirstFaultIndex : DINT
VAR
    i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _Count - 1 DO
    IF _Children[i].HasFault THEN
        FirstFaultIndex := i;
        RETURN;
    END_IF
END_FOR
FirstFaultIndex := _Count;            // no child has a fault
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DescribeFault" Id="{e73c7bb2-f2f3-431d-85ed-7dea1d468da0}">
      <Declaration><![CDATA[METHOD PRIVATE DescribeFault : STRING
VAR_INPUT
    Index : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Index < _Count THEN
    DescribeFault := CONCAT(CONCAT(_Children[Index].Name, ': '), _Children[Index].FaultText);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{7aa0ad69-5184-4be1-bb25-58f4f5070a4f}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{bbf64da4-f5f9-4a9c-b080-4edd5a761c2b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{191cd794-1cc7-4833-bb2d-a4c912d04755}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{2c5f48dd-947e-4748-b9ee-6a95ad8d84df}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := FirstFaultIndex() < _Count;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{81bdde44-aee3-46a5-bfae-3cca9fe62f90}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{5c8f35b8-cc50-4198-b37e-64ded9a506b5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FaultText := DescribeFault(Index := FirstFaultIndex());
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ChildCount" Id="{22bb6ff0-1add-4a6f-bcf2-87e79716d8fa}">
      <Declaration><![CDATA[PROPERTY PUBLIC ChildCount : DINT]]></Declaration>
      <Get Name="Get" Id="{dea68905-fd9c-479d-88e3-0a4d2d5137b5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildCount := _Count;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
