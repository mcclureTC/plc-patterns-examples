<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FakeEquipmentModule" Id="{2955b10d-6ceb-4adc-9fce-9ababfec0bfb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FakeEquipmentModule IMPLEMENTS I_EquipmentModule, I_Resettable
VAR
    _Name        : STRING(32);
    _IsCycleDone : BOOL;
    _HasFault    : BOOL;
    _StartCount  : DINT;
    _ResetCount  : DINT;
END_VAR
(*
    FakeEquipmentModule

    Test double for I_EquipmentModule. Counts the cycles it was asked for
    and the resets it received. A requested cycle finishes when the test
    calls FinishCycle(); a fault is reported while the test sets one.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_EquipmentModule" Id="{bcfe0df1-ec1d-4858-94c1-ad8aecccdfbc}" />
    <Folder Name="I_Diagnosable" Id="{23e14fac-634e-4ca9-a52f-7a08ff95eb20}" />
    <Folder Name="I_Resettable" Id="{04f6b7a4-42a7-4545-82ef-83c9ef3dc110}" />
    <Method Name="FB_init" Id="{b6b6ebf4-2506-4ba9-b710-7fb80e018c33}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartCycle" Id="{b6bd3460-d333-4af2-bb96-f12c830723e1}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[METHOD PUBLIC StartCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StartCount := _StartCount + 1;
_IsCycleDone := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{9a70f26c-ee0e-4fe8-9be8-d12a2dcb5772}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetCount := _ResetCount + 1;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FinishCycle" Id="{9ce9c12f-a6c0-4852-a37b-31ca71fa68f9}">
      <Declaration><![CDATA[METHOD PUBLIC FinishCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsCycleDone := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetFault" Id="{0d50dd19-1d9b-4b6a-b9fb-cab083dce87c}">
      <Declaration><![CDATA[METHOD PUBLIC SetFault
VAR_INPUT
    IsActive : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HasFault := IsActive;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{11aa703b-eeec-42dd-88a2-bc864212d408}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{762a8dac-070b-4c34-81b1-868f5449dd14}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{fd45e75f-5881-4410-b9af-d21ab720cb21}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{ff3df7a2-220b-4523-99f6-7d37b0e41d09}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := _HasFault;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{b0bbd7e9-16bc-443a-91b5-10693d7940fd}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{3eac4c17-eded-4cde-8315-4c1c2b9877eb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _HasFault THEN
    FaultText := 'Simulated fault';
ELSE
    FaultText := '';
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsCycleDone" Id="{2804bc3d-b717-4671-81db-c6a4a170bcc7}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsCycleDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{4ddf7807-c1c3-46a9-9bd4-b75a8e7a6120}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsCycleDone := _IsCycleDone;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StartCount" Id="{8b46515f-562b-43d7-9e75-33912ea5b101}">
      <Declaration><![CDATA[PROPERTY PUBLIC StartCount : DINT]]></Declaration>
      <Get Name="Get" Id="{83acf31a-d8fd-4c03-ad3a-2cb6c077b927}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartCount := _StartCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResetCount" Id="{0340ffa1-2fd8-4f37-8f06-493babb20d0b}">
      <Declaration><![CDATA[PROPERTY PUBLIC ResetCount : DINT]]></Declaration>
      <Get Name="Get" Id="{0c9f8603-53b6-46ee-b1ab-1aa5ed732446}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResetCount := _ResetCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
