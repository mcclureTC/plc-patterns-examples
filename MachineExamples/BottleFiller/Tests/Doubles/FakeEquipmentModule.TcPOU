<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FakeEquipmentModule" Id="{0564d15c-4cf7-41b0-829f-0b0099e89ca1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FakeEquipmentModule IMPLEMENTS I_EquipmentModule, I_Resettable
VAR
    _Name        : STRING(32);
    _IsCycleDone : BOOL;
    _HasFault    : BOOL;
    _StartCount  : DINT;
    _ResetCount  : DINT;
END_VAR
(*
    FakeEquipmentModule

    Test double for I_EquipmentModule. Counts the cycles it was asked for
    and the resets it received. A requested cycle finishes when the test
    calls FinishCycle(); a fault is reported while the test sets one.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_EquipmentModule" Id="{b49c8b61-c918-40eb-a7fe-a1b60026dd81}" />
    <Folder Name="I_Diagnosable" Id="{058fb314-fb9e-4870-8ff8-7b97f548f1ed}" />
    <Folder Name="I_Resettable" Id="{739097b6-a694-48fe-bc0b-89b4aaa2c369}" />
    <Method Name="FB_init" Id="{ce7e99dd-deaa-408e-b31a-ac7298db17a3}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartCycle" Id="{26c7068c-b635-40e3-a072-7c1a05ac5c70}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[METHOD PUBLIC StartCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StartCount := _StartCount + 1;
_IsCycleDone := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{4614b972-af5f-4050-84ce-562b1230192c}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetCount := _ResetCount + 1;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FinishCycle" Id="{a869f64b-8240-45e4-8120-d02a1f1caa52}">
      <Declaration><![CDATA[METHOD PUBLIC FinishCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsCycleDone := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetFault" Id="{63eccac8-e3bd-4722-b21a-87777ff2bc86}">
      <Declaration><![CDATA[METHOD PUBLIC SetFault
VAR_INPUT
    IsActive : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HasFault := IsActive;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{cd224d35-5dc7-47eb-9f5f-e8e3746d8111}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{d5b44222-b3cb-49a7-b832-38b367e121a3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{7105ec90-07f0-4bb5-a902-e2b557336c7e}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{d876bab6-2db7-4b95-9d7a-5fc84d3ffda8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasFault := _HasFault;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{483f7491-a889-4a2c-a984-4fa78d951d1b}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{ccdb1ea9-c74e-4572-b132-fdb301e4106e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _HasFault THEN
    FaultText := 'Simulated fault';
ELSE
    FaultText := '';
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsCycleDone" Id="{40b8f9ca-1605-489f-ba4e-7edfac876381}" FolderPath="I_EquipmentModule\">
      <Declaration><![CDATA[PROPERTY PUBLIC IsCycleDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{74d31ad7-fa9e-4fd1-9511-c0cbeec043b7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsCycleDone := _IsCycleDone;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StartCount" Id="{dcd0b3f3-ccca-45d4-95c8-fbb11f689cc9}">
      <Declaration><![CDATA[PROPERTY PUBLIC StartCount : DINT]]></Declaration>
      <Get Name="Get" Id="{633b894a-c6d6-455b-a4d8-e65fbd68859d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartCount := _StartCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResetCount" Id="{a6fe588c-7d76-44b4-8f9d-be5cb4d639cf}">
      <Declaration><![CDATA[PROPERTY PUBLIC ResetCount : DINT]]></Declaration>
      <Get Name="Get" Id="{b63a8de0-9aad-4883-8786-650f602c3363}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResetCount := _ResetCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
