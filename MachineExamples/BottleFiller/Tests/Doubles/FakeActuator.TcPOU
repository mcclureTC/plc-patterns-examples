<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="FakeActuator" Id="{dcce615d-b420-473f-b226-5d5f7aaa5ba2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FakeActuator IMPLEMENTS I_Actuator
VAR
    _Name         : STRING(32);
    _ExtendCount  : DINT;
    _RetractCount : DINT;
    _ResetCount   : DINT;
END_VAR
(*
    FakeActuator

    Test double for I_Actuator. Counts every call, reports its own name,
    and is always extended, so a test can tell which fake a router chose.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Actuator" Id="{394b252f-973b-40ad-8d96-fc3cbe55be44}" />
