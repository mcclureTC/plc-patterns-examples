    <Method Name="FB_init" Id="{ce979305-276c-4ff2-a808-331e246b49d2}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Extend" Id="{3fc958ef-a708-432f-a847-98f4aa54d760}" FolderPath="I_Actuator\">
      <Declaration><![CDATA[METHOD PUBLIC Extend
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExtendCount := _ExtendCount + 1;
]]></ST>
      </Implementation>
    </Method>
