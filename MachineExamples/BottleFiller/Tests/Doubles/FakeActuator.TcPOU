]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{5264980b-80e5-4080-bcc6-48bdf06774cf}" FolderPath="I_Resettable\">
      <Declaration><![CDATA[METHOD PUBLIC Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetCount := _ResetCount + 1;
]]></ST>
      </Implementation>
    </Method>
