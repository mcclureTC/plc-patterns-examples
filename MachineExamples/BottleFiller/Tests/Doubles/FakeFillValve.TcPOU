      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Name         : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := Name;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{da2aa806-2ed8-43c7-9e7d-03a8943accaf}" FolderPath="I_FillValve\">
      <Declaration><![CDATA[METHOD PUBLIC Open
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OpenCount := _OpenCount + 1;
]]></ST>
      </Implementation>
    </Method>
