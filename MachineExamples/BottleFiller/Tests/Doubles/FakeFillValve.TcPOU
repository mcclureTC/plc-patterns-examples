  <POU Name="FakeFillValve" Id="{099672ed-f3b9-47ef-9bac-69c1b430ca3b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FakeFillValve IMPLEMENTS I_FillValve
VAR
    _Name      : STRING(32);
    _OpenCount : DINT;
END_VAR
(*
    FakeFillValve

    Test double for I_FillValve. Counts Open() calls, reports its own name,
    and is always open.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_FillValve" Id="{c6e60483-c25c-4a67-86b0-ac6ee4e39edd}" />
    <Folder Name="I_Diagnosable" Id="{c22d05df-ed7f-4b66-9b43-9e6439d31f44}" />
