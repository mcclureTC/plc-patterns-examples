<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="TestMain" Id="{a7753014-1b24-4033-a4ed-88a1defb11e6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM TestMain
VAR
    LineTest    : LineRunsStopsAndFaultsTest;
    ValveTest   : SimulatedValveTakesItsTravelTimeTest;
    CheckTest   : SimulationCheckTest;
    HasRun      : BOOL;
    AllPassed   : BOOL;
    FailedCount : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Each test runs once, on the first scan. None of them touches the machine's
// instances or its I/O. Read AllPassed, FailedCount and each test's
// LastFailure in a watch window.
IF NOT HasRun THEN
    HasRun := TRUE;
    LineTest.Run();
    ValveTest.Run();
    CheckTest.Run();
    AllPassed := LineTest.HasPassed AND ValveTest.HasPassed AND CheckTest.HasPassed;
    FailedCount := LineTest.FailedCount + ValveTest.FailedCount + CheckTest.FailedCount;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
