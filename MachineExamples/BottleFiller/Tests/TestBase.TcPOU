<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="TestBase" Id="{00d9475d-5935-4b0d-a71b-28a102aa94b4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT TestBase
VAR
    _CheckCount  : INT;
    _FailedCount : INT;
    _LastFailure : STRING(255);
END_VAR
(*
    TestBase

    Shared bookkeeping for framework-free tests. A derived test implements
    Run() and calls Check() for everything it wants to verify.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Run" Id="{4c16e47f-57f9-412a-8ad0-d28ec9a619a6}">
      <Declaration><![CDATA[METHOD PUBLIC ABSTRACT Run
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Check" Id="{c6242960-d1b8-4a18-be43-d329ebe3b52b}">
      <Declaration><![CDATA[METHOD PROTECTED Check
VAR_INPUT
    Condition : BOOL;
    Message   : STRING(255);    // what should be true, not what went wrong
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CheckCount := _CheckCount + 1;
IF NOT Condition THEN
    _FailedCount := _FailedCount + 1;
    _LastFailure := Message;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasPassed" Id="{4e595662-ae47-4cfc-8a1c-27a0ca77691a}">
      <Declaration><![CDATA[PROPERTY PUBLIC HasPassed : BOOL]]></Declaration>
      <Get Name="Get" Id="{fa494ea5-fe5b-44dd-ad83-4cc0bad07c3f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasPassed := _CheckCount > 0 AND _FailedCount = 0;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FailedCount" Id="{787a173b-d7bd-4af3-a47a-03a7371f1103}">
      <Declaration><![CDATA[PROPERTY PUBLIC FailedCount : INT]]></Declaration>
      <Get Name="Get" Id="{2e6372e1-7eba-4f14-9c6c-b7cf27dfbd5a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FailedCount := _FailedCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="LastFailure" Id="{0ae27779-fd5b-4f61-b1d2-44d4cb5fcf95}">
      <Declaration><![CDATA[PROPERTY PUBLIC LastFailure : STRING(255)]]></Declaration>
      <Get Name="Get" Id="{254a139e-d29a-4440-812a-ca0016b9e6d3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastFailure := _LastFailure;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
