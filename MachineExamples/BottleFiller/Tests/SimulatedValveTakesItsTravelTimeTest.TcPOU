<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="SimulatedValveTakesItsTravelTimeTest" Id="{f789ee55-f4fb-42a4-a501-6c7aa8a3d5d7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SimulatedValveTakesItsTravelTimeTest EXTENDS TestBase
VAR
    _Clock : FakeClock;
    _Valve : SimulatedValve(Name := 'Test valve', Clock := _Clock, TravelTime := LTIME#400MS);
END_VAR
(*
    SimulatedValveTakesItsTravelTimeTest

    The simulated valve reports neither end while it travels, reaches open
    after its travel time, and doesn't move at all while stuck.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Run" Id="{3c3fa6d7-318f-4ef9-8bc2-808822f4b129}">
      <Declaration><![CDATA[METHOD PUBLIC Run
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check(_Valve.IsClosed AND NOT _Valve.IsOpen, 'it starts closed');

_Valve.Open();
_Valve.CyclicLogic();
Check(NOT _Valve.IsClosed AND NOT _Valve.IsOpen, 'it reports neither end while it travels');

_Clock.Advance(Duration := LTIME#399MS);
_Valve.CyclicLogic();
Check(NOT _Valve.IsOpen, 'it is not open before its travel time');

_Clock.Advance(Duration := LTIME#1MS);
_Valve.CyclicLogic();
Check(_Valve.IsOpen, 'it is open after its travel time');

_Valve.SetStuck(IsStuck := TRUE);
_Valve.Close();
_Clock.Advance(Duration := LTIME#1S);
_Valve.CyclicLogic();
Check(_Valve.IsOpen, 'a stuck valve ignores Close()');
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
