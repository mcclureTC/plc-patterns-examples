  <GVL Name="GVL_Hmi" Id="{a79523ad-c0a9-4eed-a9d2-eca58564faad}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // From the HMI
    StartButton      : BOOL;
    StopButton       : BOOL;
    ResetButton      : BOOL;

    // To the HMI
    LineState        : E_LineState;
    IsStopping       : BOOL;
    FaultText        : STRING;
    NotFinalDevices  : STRING(255);         // every device that isn't the machine's own; empty on the machine
END_VAR
]]></Declaration>
  </GVL>
