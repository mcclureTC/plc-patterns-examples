<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Io" Id="{0303b8bc-1805-49af-bd40-0bcb205eebd6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // Filling station
    TankValveCoil  AT %Q* : BOOL;
    TankValveOpen  AT %I* : BOOL;
    DrainValveCoil AT %Q* : BOOL;
    DrainValveOpen AT %I* : BOOL;
    TankLevel      AT %I* : DINT;           // level sensor process data, 0.1 mm
    TankSensorOk   AT %I* : BOOL;           // the sensor's valid bit; see the project document

    // Pick-and-place station
    LiftValve      AT %Q* : BOOL;
    LiftDown       AT %I* : BOOL;
    LiftUp         AT %I* : BOOL;
    SlideOutCoil   AT %Q* : BOOL;
    SlideInCoil    AT %Q* : BOOL;
    SlideOut       AT %I* : BOOL;
    SlideIn        AT %I* : BOOL;
    GripperValve   AT %Q* : BOOL;
    GripperClosed  AT %I* : BOOL;
    GripperOpen    AT %I* : BOOL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
