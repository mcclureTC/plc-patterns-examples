<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.0">
  <POU Name="SiteCheck" Id="{b961bb30-662d-4bd4-ab7f-0c42f03aa951}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SiteCheck IMPLEMENTS I_Diagnosable, I_Cyclic
VAR
    _Switches         : REFERENCE TO ST_SiteSwitches;
    _Snapshot         : ST_SiteSwitches;
    _HasSnapshot      : BOOL;
    _HasChanged       : BOOL;
    _SimulatedCount   : DINT;
    _SimulatedDevices : STRING(255);
    _IsConfigured     : BOOL;
END_VAR
(*
    SiteCheck

    Keeps simulation off a production machine. Takes a copy of the site
    switches on its first scan and reports a fault, until the PLC restarts,
    if they change: the routers chose in FB_init and still hold the old
    choice. Reports a fault while any device is simulated on a machine
    marked IsOnMachine. AddSimulated() is called once per simulated device
    while wiring; SimulatedDevices names them for the HMI and for records.
*)
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Diagnosable" Id="{1dc18c53-ada1-4a98-9b90-dc1d85f6496d}" />
    <Folder Name="I_Cyclic" Id="{e64e1abc-967f-4ac9-abf3-528d4fb7a0b1}" />
    <Method Name="FB_init" Id="{9b27cc41-8d4d-4b66-8c4e-7b5f8ff91439}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode  : BOOL;
    Switches     : REFERENCE TO ST_SiteSwitches;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Switches REF= Switches;
_IsConfigured := __ISVALIDREF(Switches);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddSimulated" Id="{7273a31c-252e-4631-8e49-48a81d5f452c}">
      <Declaration><![CDATA[METHOD PUBLIC AddSimulated
VAR_INPUT
    Name : STRING(32);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SimulatedCount := _SimulatedCount + 1;
IF _SimulatedCount = 1 THEN
    _SimulatedDevices := Name;
ELSE
    _SimulatedDevices := CONCAT(CONCAT(_SimulatedDevices, ', '), Name);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{5d5c7edd-e460-4f86-a854-a173f663762f}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsConfigured THEN
    RETURN;
END_IF
IF NOT _HasSnapshot THEN
    _Snapshot := _Switches;
    _HasSnapshot := TRUE;
    RETURN;
END_IF
IF MEMCMP(pBuf1 := ADR(_Snapshot), pBuf2 := ADR(_Switches), n := SIZEOF(_Snapshot)) <> 0 THEN
    _HasChanged := TRUE;                        // latched until the PLC restarts
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{01bd66de-dd41-4681-bd1e-2e4a4badd239}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC Name : STRING]]></Declaration>
      <Get Name="Get" Id="{f9fd2033-d7d4-4ddf-bb75-4ae207cfad93}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := 'Site switches';
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasFault" Id="{e3795065-c80a-489d-bc69-841f5abd9659}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC HasFault : BOOL]]></Declaration>
      <Get Name="Get" Id="{1f827f14-afda-4583-a29c-b0d506c0524b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _IsConfigured THEN
    HasFault := TRUE;
ELSE
    HasFault := _HasChanged OR (_Switches.IsOnMachine AND _SimulatedCount > 0);
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FaultText" Id="{6f93f636-955a-4b65-9d3e-bfeb0e055b51}" FolderPath="I_Diagnosable\">
      <Declaration><![CDATA[PROPERTY PUBLIC FaultText : STRING]]></Declaration>
      <Get Name="Get" Id="{3be343ee-f0e3-4636-83e2-d37252414f21}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _IsConfigured THEN
    FaultText := 'Site switches not wired';
ELSIF _HasChanged THEN
    FaultText := 'Site switches changed; restart the PLC';
ELSIF _Switches.IsOnMachine AND _SimulatedCount > 0 THEN
    FaultText := CONCAT('Simulated on the machine: ', _SimulatedDevices);
ELSE
    FaultText := '';
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SimulatedDevices" Id="{28eda224-a0b4-4748-9e92-30358f307fdb}">
      <Declaration><![CDATA[PROPERTY PUBLIC SimulatedDevices : STRING(255)]]></Declaration>
      <Get Name="Get" Id="{d490634d-88bd-4bcd-b33a-be259d52ffe4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SimulatedDevices := _SimulatedDevices;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SimulatedCount" Id="{53f0dee0-4fd0-410c-b529-a890840a9ce1}">
      <Declaration><![CDATA[PROPERTY PUBLIC SimulatedCount : DINT]]></Declaration>
      <Get Name="Get" Id="{8a37ab04-44c3-48eb-8ab4-317bb36b9a7c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SimulatedCount := _SimulatedCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
